# Runtime de la app — rol `app_user` (NOBYPASSRLS), nunca `postgres`/`service_role`.
# Ver docs/architecture/backend-architecture.md#Database Architecture.
DATABASE_URL=

# Solo para `prisma migrate deploy` (CI/CD) — rol owner del schema.
DIRECT_URL=

# Supabase Auth — clave pública (anon), expuesta al browser por diseño.
# Ver Project Settings > API en el dashboard de Supabase. Story 1.2.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
