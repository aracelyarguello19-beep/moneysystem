{
  "name": "sistema-control-financiero",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=apps/web",
    "dev": "npm run dev --workspace=apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace=apps/web --if-present",
    "db:migrate:test": "npm run db:migrate:test --workspace=packages/database",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=packages/database",
    "aiox": "node .aiox-core/cli/index.js",
    "validate": "node .aiox-core/cli/index.js validate",
    "validate:squad-structure": "node .aiox-core/cli/scripts/validate-squad-structure.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "js-yaml": "^5.4.1",
    "puppeteer": "^25.10.0",
    "turndown": "^7.2.4",
    "yaml": "^2.9.0"
  }
}
